{
  "name": "pi-claude-plugins",
  "version": "0.1.0",
  "description": "pi extension that loads Claude Code plugins natively: skills, commands, agents, hooks and MCP servers",
  "license": "MIT",
  "author": "mediavee",
  "homepage": "https://github.com/mediavee/pi-claude-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mediavee/pi-claude-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/mediavee/pi-claude-plugins/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "claude-code",
    "plugins",
    "skills",
    "hooks",
    "mcp"
  ],
  "files": [
    "src",
    "docs/design.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
